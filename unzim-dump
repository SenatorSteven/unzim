#!/bin/bash

NAME="unzim-dump"

function main(){
	local outputFileName="/tmp/unzim-output";
	local zimName="$1";
	local itemName="$2";
	local returnValue=0;
	cd "${BASH_SOURCE%/*}";
	if [ ! -f "$NAME" ]; then
		printf "%s: could not find script directory\n" "$NAME";
		return 1;
	fi
	if [ -z "$zimName" ]; then
		printf "%s: no zim archive given\n" "$NAME";
		return 2;
	fi
	if [ -z "$itemName" ]; then
		printf "%s: no item name given\n" "$NAME";
		return 3;
	fi
	mkdir -p "$outputFileName";
	if [ "$itemName" == "all" ]; then
		zimdump dump --dir="$outputFileName" -- "$zimName";
		returnValue=$?;
	else
		itemIndex=$(zimdump list --url="$itemName" -- "$zimName");
		returnValue=$?;
		if [ $returnValue -eq 0 ]; then
			itemIndex=$(printf "%s\n" "$itemIndex" | awk '/idx/ {print $3}');
			zimdump show --idx="$itemIndex" -- "$zimName" > "$outputFileName/$itemName";
			returnValue=$?;
		fi
	fi
	if [ $returnValue -eq 0 ]; then
		printf "done\n";
	fi
	return $returnValue;
}

main "$@"
exit $?

