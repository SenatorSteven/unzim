
#!/bin/bash

NAME="unzim-dump"

function main(){
	outputFileName="/tmp/unzim-output";
	zimName="$1";
	itemName="$2";
	cd "${BASH_SOURCE%/*}";
	if [ ! -f "$NAME" ]; then
		printf "%s: could not find script directory\n" "$NAME";
		return 1;
	fi
	if [ -z "$zimName" ]; then
		printf "%s: no zim archive given\n" "$NAME";
		return 2;
	fi
	if [ -z "$itemName" ]; then
		printf "%s: no item name given\n" "$NAME";
		return 3;
	fi
	mkdir -p "$outputFileName";
	if [ "$itemName" == "all" ]; then
		zimdump dump --dir="$outputFileName" -- "$zimName";
	else
		itemIndex=$(zimdump list --url="$itemName" -- "$zimName" | grep idx | awk '{print $3}');
		zimdump show --idx="$itemIndex" -- "$zimName" > "$outputFileName/$itemName";
	fi
	printf "done\n";
	return 0;
}

main "$@"
exit $?

